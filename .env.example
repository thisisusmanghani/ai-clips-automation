# YouTube Automation Pipeline - Environment Variables
# Copy this file to .env and fill in your values

# Google API Key (for YouTube Data API)
GOOGLE_API_KEY=

# OAuth Client Secrets (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Sheets Spreadsheet ID (will be auto-created if not provided)
SPREADSHEET_ID=

# YouTube Channel ID (optional, auto-detected from auth)
YOUTUBE_CHANNEL_ID=

# Timezone for scheduling
TIMEZONE=America/New_York
